# Django CMS backend (Tours/Vehicles content + SEO update endpoints)
VITE_DJANGO_API_URL=https://web-production-1ab9.up.railway.app
# Shared secret for the CMS SEO update endpoints. Must match SEO_UPDATE_KEY on the Django server.
VITE_SEO_UPDATE_KEY=

# GitHub (reads + opens PRs against the two Next.js site repos)
VITE_GITHUB_TOKEN=
VITE_CTC_GITHUB_REPO=mohamadxnadeem/capetown-concierge
VITE_SIGMA_GITHUB_REPO=mohamadxnadeem/sigma-chauffeur
VITE_GITHUB_BRANCH=main

# Anthropic API key (claude-sonnet-4-20250514). Required for the agents to run.
# Get one at https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# Google Search Console properties (rankings + index status). Configurable in the
# Django panel too. Domain properties use the sc-domain: form.
VITE_CTC_GSC_PROPERTY=sc-domain:capetown-concierge.co.za
VITE_SIGMA_GSC_PROPERTY=sc-domain:sigmachauffeur.vip

# All values above are also configurable in the UI (top-bar AI / Django / GitHub
# panels) and saved to localStorage.

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (set in Vercel → Settings → Environment Variables, NOT here).
# Powers the /api/gsc serverless proxy. This is the full JSON of a Google Cloud
# service-account key (one line). Never expose it to the browser / never prefix VITE_.
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
